.container {
  min-height: 100vh;
  padding: 0 24rpx 32rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.title {
  padding: 28rpx 0 18rpx;
  color: #1f2937;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  color: #475569;
  font-size: 26rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.alert-panel {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  color: #991b1b;
  background: #fee2e2;
  border: 1rpx solid #fecaca;
  border-radius: 8rpx;
}

.alert-item {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.card-container {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.data-card {
  padding: 22rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.card-title {
  padding-bottom: 14rpx;
  margin-bottom: 10rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  border-bottom: 1rpx solid #edf0f5;
}

.data-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.data-row:last-child {
  border-bottom: 0;
}

.data-value {
  color: #2563eb;
  font-size: 30rpx;
  font-weight: 700;
}

.data-label {
  color: #334155;
  font-size: 30rpx;
}

.empty-text {
  padding: 24rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
  text-align: center;
}

.section-title {
  display: block;
  margin: 8rpx 0 14rpx;
  color: #475569;
  font-size: 28rpx;
}

.body-view {
  padding: 8rpx 0 0;
}

slider {
  margin: 12rpx 0;
}
